FROM fedora:latest

RUN dnf -y install \
        git \
        nodejs \
        npm \
        golang \
        ca-certificates \
        ripgrep \
        jq \
        ncurses-term \
        diffutils \
        which \
        procps-ng \
        gcc \
        python3-pip \
        'dnf-command(config-manager)' \
    && dnf -y config-manager addrepo --from-repofile=https://cli.github.com/packages/rpm/gh-cli.repo \
    && dnf -y install gh \
    && dnf -y config-manager addrepo --from-repofile=https://acli.atlassian.com/linux/rpm/acli.repo \
    && dnf -y install acli \
    && dnf clean all

# claude-code is installed here as root, so the unprivileged `claude` user
# (added below) has no write access to the npm global prefix. Auto-update
# would fail with "no write permission to npm prefix" every session; updates
# are applied by rebuilding this image instead, so disable the in-container
# updater outright.
ENV DISABLE_AUTOUPDATER=1
RUN npm install -g @anthropic-ai/claude-code @openai/codex

# Separate RUN step: claude-code-wakatime's postinstall shells out to
# `claude plugin marketplace add`/`claude plugin i`, which needs the `claude`
# native binary already in place — installing it in the same npm invocation
# as @anthropic-ai/claude-code races that binary's own postinstall/download
# and fails with "claude native binary not installed".
RUN npm install -g claude-code-wakatime

# oc: official OpenShift CLI stable release (not dnf-packaged on Fedora).
RUN curl -sSL https://mirror.openshift.com/pub/openshift-v4/clients/ocp/stable/openshift-client-linux.tar.gz \
        | tar -xz -C /usr/local/bin oc \
    && chmod +x /usr/local/bin/oc

# yq: mikefarah/yq Go binary (not dnf's python yq, which is a jq wrapper
# with an incompatible CLI).
RUN curl -sSL https://github.com/mikefarah/yq/releases/latest/download/yq_linux_amd64 \
        -o /usr/local/bin/yq \
    && chmod +x /usr/local/bin/yq

# AI Hero skills (https://www.aihero.dev/skills, mattpocock/skills). Baked
# into the image rather than installed on the host: the image is rebuilt
# --no-cache on every chezmoi apply, so this tracks upstream HEAD the same
# way the npm installs above do, and the host's ~/.claude/{plugins,skills}
# stay untouched (both are bind-mounted read-only over the in-image paths,
# so nothing baked there would be visible anyway).
# - Claude: loaded as a plugin via `claude --plugin-dir /opt/mattpocock-skills`
#   (claude::sandbox::_run), skills namespaced `mattpocock-skills:<name>`.
# - Codex: /etc/codex/skills is Codex's admin-scope skill dir; populated
#   flat with exactly the skills the upstream plugin.json ships (skips the
#   repo's in-progress/ and misc/ drafts).
RUN git clone --depth 1 https://github.com/mattpocock/skills /opt/mattpocock-skills \
    && mkdir -p /etc/codex/skills \
    && jq -r '.skills[]' /opt/mattpocock-skills/.claude-plugin/plugin.json \
        | while read -r s; do cp -r "/opt/mattpocock-skills/$s" /etc/codex/skills/; done

# Rootless bind mounts can present /workspace with an ownership git doesn't
# recognize as "mine" by default. This container is a throwaway sandbox
# scoped to a single worktree mount, so a blanket safe.directory is fine.
# Baked into system config (not ~/.gitconfig) since the user's .gitconfig is
# bind-mounted read-only at runtime.
RUN git config --system --add safe.directory '*'

# Worktrees mounted here point back at fsmonitor state (a Unix socket) from
# the canonical repo on the host, which is unreachable from inside the
# container — disable it so git doesn't try to query a dead socket.
RUN git config --system core.fsmonitor false

RUN useradd --create-home --home-dir /home/claude --shell /bin/bash claude

USER claude
WORKDIR /workspace

# rustup-managed toolchain (not dnf's rust/cargo/rustfmt/clippy packages):
# clippy and rustfmt are rustup components, not crates.io packages — `cargo
# install clippy` doesn't work (it's a placeholder crate that errors out and
# points at rustup) — so rustup is the only way to get cargo/rustfmt/clippy
# from one consistent toolchain manager, with cargo-nextest layered on top
# via a normal `cargo install` since it's a real crate.
ENV RUSTUP_HOME=/home/claude/.rustup \
    CARGO_HOME=/home/claude/.cargo \
    PATH=/home/claude/.cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain stable --profile default
RUN cargo install cargo-nextest --locked

# gopls (Go language server) + mcp-language-server (stdio MCP bridge in
# front of it) so Codex can do symbol-level Go navigation (definitions,
# references, hover, diagnostics) instead of grepping. Wired into Codex via
# the [mcp_servers.gopls] entry in codex-config.toml below.
ENV GOBIN=/home/claude/.local/bin \
    PATH=/home/claude/.local/bin:$PATH
RUN mkdir -p /home/claude/.local/bin && \
    go install golang.org/x/tools/gopls@latest && \
    go install github.com/isaacphi/mcp-language-server@latest

# Skeleton ~/.claude so per-run bind mounts (files and dirs) have a valid
# target to land on - podman errors bind-mounting onto a path that doesn't
# exist yet.
RUN mkdir -p \
        /home/claude/.claude/commands \
        /home/claude/.claude/plugins \
        /home/claude/.claude/projects \
        /home/claude/.config/gcloud \
        /home/claude/.kube \
        /home/claude/.agents/skills \
        /home/claude/.codex/sessions \
    && touch \
        /home/claude/.claude/CLAUDE.md \
        /home/claude/.claude/.credentials.json \
        /home/claude/.claude/statusline-command.sh \
        /home/claude/.claude/slogans.txt \
        /home/claude/.claude.json \
        /home/claude/.config/gcloud/application_default_credentials.json \
        /home/claude/.kube/config \
        /home/claude/.codex/AGENTS.md \
    && chmod 600 /home/claude/.claude/.credentials.json

COPY --chown=claude:claude settings.json /home/claude/.claude/settings.json
COPY --chown=claude:claude codex-config.toml /home/claude/.codex/config.toml
COPY --chown=claude:claude entrypoint.sh /home/claude/entrypoint.sh
RUN chmod +x /home/claude/entrypoint.sh

ENTRYPOINT ["/home/claude/entrypoint.sh"]
